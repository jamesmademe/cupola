# Cloudflare Pages headers. The site is static and takes no input; scripts are
# Astro's own inlined modules plus Cloudflare Web Analytics, and nothing is
# framed.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# The project's own pages.dev address serves the same pages as get-seekarr.org.
# Keep it out of search so only the real domain is indexed (previews already
# carry noindex from Cloudflare).
https://:project.pages.dev/*
  X-Robots-Tag: noindex

# The plain-text account of the site, for agents that read headers before the
# page (the page itself links it too).
/
  Link: </llms.txt>; rel="describedby"; type="text/plain"

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/art/*
  Cache-Control: public, max-age=604800
/brand/*
  Cache-Control: public, max-age=604800
/og/*
  Cache-Control: public, max-age=86400
