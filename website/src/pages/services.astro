---
import Guide from '../layouts/Guide.astro';
import ServiceTable from '../components/ServiceTable.astro';
import { services } from '../lib/repo';
import { pick } from '../data/faq';
import { site } from '../config';

const all = services();
const n = (t: string) => all.filter((s) => s.tested === t).length;
const cats = ['Media', 'Downloads', 'Stream', 'Infrastructure'] as const;
const blurb = {
  Media: 'Finding, requesting and keeping titles.',
  Downloads: 'Getting them, and the indexers behind it.',
  Stream: 'Who is watching, and how.',
  Infrastructure: 'The machine everything runs on.',
};
---
<Guide
  page="services"
  lede={`Cupola connects to ${all.length} self-hosted services. Set up only the ones you run. Each one says what Cupola can do with it, and whether we have tested it on a real server.`}
  questions={pick('tested', 'certs')}
  related={['arr', 'downloads', 'homelab']}
>
  <h2>How to read this page</h2>
  <ul>
    <li><strong>Control</strong> is how far Cupola goes: full read and write, or mostly reading.</li>
    <li><span class="tone-green">✓</span> <strong>Verified</strong> on a real server, screens and actions ({n('verified')} of {all.length}).</li>
    <li>◐ <strong>Partly verified</strong>: the screens have read a real server, the actions not yet ({n('partial')}).</li>
    <li>○ <strong>Recorded answers only</strong>: not yet tried on a running server ({n('untested')}).</li>
    <li>Run one that is not fully verified? <a href={`${site.issues}/new`} rel="noopener">Tell us how it goes</a>, either way.</li>
  </ul>

  <div class="not-prose">
    {cats.map((c) => (
      <section class="cat" aria-labelledby={`cat-${c}`}>
        <h2 id={`cat-${c}`}>{c}</h2>
        <p class="t-meta">{blurb[c]}</p>
        <ServiceTable ids={all.filter((s) => s.category === c).map((s) => s.id)} anchors />
      </section>
    ))}
  </div>
</Guide>

<style>
  .not-prose {
    width: min(var(--well), calc(100vw - 2 * var(--gutter)));
  }
  .cat {
    margin-top: 56px;
  }
  .cat h2 {
    margin-top: 0;
    margin-bottom: 6px;
  }
  .cat .t-meta {
    margin-bottom: 20px;
  }
</style>
