---
import { readFileSync } from 'node:fs';
import { marked } from 'marked';
import Guide from '../layouts/Guide.astro';
import { inRepo } from '../lib/paths';
import { site } from '../config';

// The repository's changelog, as written there.
const md = readFileSync(inRepo('CHANGELOG.md'), 'utf8').replace(/^# Changelog\s*/m, '');
const html = await marked.parse(md.replace(/^## /gm, '## Cupola '), { gfm: true });
---
<Guide
  page="changelog"
  lede={`What changed in each release, from the <a href="${site.repo}/blob/main/CHANGELOG.md">changelog in the repository</a>. Releases and their files are on <a href="${site.releases}">GitHub</a>.`}
  related={['install', 'seekarr', 'contribute']}
  get={false}
>
  <div class="log" set:html={html} />
</Guide>

<style>
  .log :global(h2) {
    margin-top: 0;
  }
  .log :global(h3) {
    margin-top: 1.8em;
  }
  .log :global(ul) {
    padding-left: 1.1em;
  }
  .log :global(li + li) {
    margin-top: 0.5em;
  }
  .log :global(li),
  .log :global(p) {
    color: var(--ink-2);
  }
  .log :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .log :global(code) {
    font-size: 0.86em;
  }
</style>
