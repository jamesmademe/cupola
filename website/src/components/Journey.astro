---
// One title followed through Cupola, frame by frame: found, added, fetched,
// ready. Each frame lights the room as it comes into view, and carries the
// words the app says at that step.
import Icon from './Icon.astro';
import { still, poster, lit, lightOf, type StillId } from '../data/titles';

const steps: { still: StillId; label: string; title: string; body: string; pos: string }[] = [
  {
    still: 'singfind',
    label: 'Discover',
    title: 'It shows up.',
    body: 'Trending this week, lit by its own artwork. One search already tells you whether it is on your server.',
    pos: '45% center',
  },
  {
    still: 'singadd',
    label: 'A title',
    title: 'One tap from its page.',
    body: 'Add it to Radarr, or send a request when the server is someone else’s.',
    pos: '70% center',
  },
  {
    still: 'singget',
    label: 'Activity',
    title: 'Followed to the disk.',
    body: 'Activity keeps an eye on the download. If it stalls, it says why and what to try.',
    pos: '30% center',
  },
  {
    still: 'singready',
    label: 'Home',
    title: 'Ready when you are.',
    body: 'Home shows it arrived, and whoever asked for it hears about it, if they turned that on.',
    pos: '55% center',
  },
];
---
<ol class="journey">
  {steps.map((s, i) => (
    <li class="frame rise" {...lit(s.still)} style={`--bg:url(${still(s.still)});--bg-s:url(${still(s.still, true)});--pos:${s.pos};--light:${lightOf(s.still).light};--light-fill:${lightOf(s.still).fill}`}>
      <div class="words">
        <p class="t-micro"><span class="n tabular">{i + 1}</span> {s.label}</p>
        <h3 class="t-room">{s.title}</h3>
        <p class="body">{s.body}</p>
      </div>
      <div class="chip" aria-hidden="true">
        {i === 0 && (
          <div class="row">
            <img src={poster('singularity')} alt="" width="44" height="66" loading="lazy" />
            <div><span class="k">Trending this week</span><b>Singularity</b><span class="k">2026 · Adventure</span></div>
          </div>
        )}
        {i === 1 && (
          <>
            <span class="lit-btn">Add to Radarr<Icon name="plus" size={18} /></span>
            <span class="k"><span class="dot neutral"></span> Radarr · Missing</span>
          </>
        )}
        {i === 2 && (
          <>
            <b>Singularity</b>
            <span class="k tone-blue tabular">Downloading 62% · ready around 21:40</span>
            <i class="bar"><i></i></i>
          </>
        )}
        {i === 3 && (
          <>
            <span class="k"><span class="dot green"></span> Ready to watch</span>
            <b>Singularity is on your server</b>
            <span class="k">Alex asked for it on Thursday</span>
          </>
        )}
      </div>
    </li>
  ))}
</ol>

<style>
  .journey {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
  }
  .frame {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    aspect-ratio: 2.39 / 1;
    padding: clamp(20px, 3vw, 40px);
    border-radius: var(--r-slab);
    overflow: hidden;
    background:
      linear-gradient(to top, rgb(10 10 13 / 0.88), rgb(10 10 13 / 0.1) 55%, transparent),
      var(--bg) var(--pos) / cover no-repeat,
      var(--slab);
    border: 1px solid var(--hair);
    box-shadow: 0 50px 110px -50px color-mix(in srgb, var(--light) 60%, transparent);
  }
  .words {
    max-width: 440px;
    display: grid;
    gap: 10px;
  }
  .words .n {
    color: var(--ink);
    margin-right: 4px;
  }
  .body {
    color: var(--ink-2);
    font-size: 16px;
  }
  .chip {
    flex: none;
    display: grid;
    gap: 6px;
    min-width: 240px;
    padding: 14px 16px;
    border-radius: var(--r-group);
    background: rgb(26 26 31 / 0.9);
    border: 1px solid var(--hair);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.45);
    font-size: 15px;
  }
  .chip b {
    font-weight: 600;
  }
  .chip .k {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-2);
  }
  .chip .tone-blue {
    color: var(--blue);
  }
  .row {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .row img {
    width: 44px;
    height: 66px;
    border-radius: var(--r-thumb);
    object-fit: cover;
  }
  .row div {
    display: grid;
    gap: 2px;
  }
  .lit-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 44px;
    padding: 0 14px 0 16px;
    border-radius: var(--r-control);
    background: var(--light-fill);
    color: var(--ink-on);
    font-weight: 600;
  }
  .bar {
    display: block;
    height: 4px;
    margin-top: 4px;
    border-radius: 2px;
    background: var(--fill-strong);
    overflow: hidden;
  }
  .bar i {
    display: block;
    width: 62%;
    height: 100%;
    background: var(--blue);
  }
  @media (max-width: 760px) {
    .frame {
      aspect-ratio: auto;
      min-height: 112vw;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-end;
      background:
        linear-gradient(to top, rgb(10 10 13 / 0.94), rgb(10 10 13 / 0.2) 60%, transparent),
        var(--bg-s) var(--pos) / cover no-repeat,
        var(--slab);
    }
    .chip {
      min-width: 0;
      order: -1;
      align-self: flex-start;
    }
  }
</style>
