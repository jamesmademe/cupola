---
// Where to get Cupola, per platform. A platform whose link is not set yet
// says so instead of offering a button that leads nowhere. The visitor's own
// platform, when the browser says which it is, comes first.
import Icon from './Icon.astro';
import { site } from '../config';

const d = site.downloads;
const desktop = d.windows && d.linux ? { windows: d.windows, linux: d.linux } : null;
const platforms = [
  {
    id: 'ios',
    icon: 'apple',
    name: 'iPhone and iPad',
    how: 'TestFlight beta, from Apple',
    href: d.testflight,
    action: 'Join the beta',
    alt: null,
  },
  {
    id: 'android',
    icon: 'android',
    name: 'Android',
    how: 'APK from GitHub releases',
    href: d.apk,
    action: 'Download the APK',
    alt: null,
  },
  {
    id: 'mac',
    icon: 'desktop',
    name: 'Mac',
    // TestFlight first, as on iPhone; the dmg stays one link away.
    href: d.testflight ?? d.macos,
    action: d.testflight ? 'Join the beta' : 'Download for Mac',
    how: d.testflight ? 'TestFlight beta, from Apple' : 'Signed and notarized .dmg',
    alt: d.testflight && d.macos ? { href: d.macos, label: 'Or download the signed .dmg, for Apple silicon' } : null,
  },
] as const;
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---
<div class:list={['get', { compact }]} data-get>
  {platforms.map((p) => (
    <div class="plat" data-platform={p.id}>
      <div class="head">
        <Icon name={p.icon} size={26} />
        <div>
          <h3 class="t-section">{p.name}</h3>
          <p class="t-meta">{p.how}</p>
        </div>
      </div>
      {p.href ? (
        <div class="go">
          <a class="btn btn-lit" href={p.href} rel="noopener">{p.action}<Icon name="arrow" /></a>
          {p.alt && <a class="alt t-meta" href={p.alt.href} rel="noopener">{p.alt.label}</a>}
        </div>
      ) : (
        <p class="wait"><span class="dot neutral"></span><span>Not open yet. <a href={site.watch} rel="noopener">Watch releases</a> to hear when it is.</span></p>
      )}
    </div>
  ))}
  {!compact && (
    <p class="rest t-meta">
      {desktop ? (
        <>Builds for <a href={desktop.windows} rel="noopener">Windows</a> and <a href={desktop.linux} rel="noopener">Linux</a> come with every <a href={site.releases} rel="noopener">release</a>, not yet tested on real machines. Or <a href="/install/#source">build it from source</a>.</>
      ) : (
        <>Windows and Linux builds will come with the first release on GitHub. Until then, <a href="/install/#source">build it from source</a>.</>
      )}
    </p>
  )}
</div>

<script>
  const ua = navigator.userAgent;
  const mine = /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1)
    ? 'ios'
    : /Android/.test(ua)
      ? 'android'
      : /Macintosh/.test(ua)
        ? 'mac'
        : '';
  if (mine) {
    document.querySelectorAll<HTMLElement>('[data-get]').forEach((g) => {
      const el = g.querySelector<HTMLElement>(`[data-platform="${mine}"]`);
      if (!el) return;
      el.classList.add('mine');
      g.prepend(el);
    });
  }
</script>

<style>
  .get {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .plat {
    display: grid;
    align-content: space-between;
    gap: 22px;
    padding: 22px;
    border-radius: var(--r-slab);
    background: rgb(18 18 24 / 0.82);
    border: 1px solid var(--hair);
    transition: border-color var(--standard) var(--ease);
  }
  .plat:global(.mine) {
    border-color: color-mix(in srgb, var(--light) 50%, transparent);
    box-shadow: 0 30px 70px -30px color-mix(in srgb, var(--light) 50%, transparent);
  }
  .head {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .head > :global(svg) {
    margin-top: 2px;
    color: var(--ink-2);
  }
  .head h3 {
    /* The install page sets these cards inside its prose, whose h3 margin
       would push the name below its icon. */
    margin-top: 0;
  }
  .head p {
    margin-top: 4px;
  }
  .plat .btn {
    justify-content: space-between;
    width: 100%;
  }
  .go {
    display: grid;
    gap: 12px;
  }
  .alt {
    justify-self: center;
    color: var(--ink-2);
  }
  .wait {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 10px;
    align-items: baseline;
    min-height: 52px;
    align-content: center;
    font-size: 15px;
    color: var(--ink-2);
  }
  .wait .dot {
    transform: translateY(-1px);
  }
  .rest {
    grid-column: 1 / -1;
    margin-top: 6px;
  }
  @media (max-width: 860px) {
    .get {
      grid-template-columns: 1fr;
    }
  }
</style>
