<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Tells the user a background release search finished. This is the only
         permission the notification plugin needs, because `zonedSchedule` is
        never called, which is what keeps this clear of the Play-restricted
         exact-alarm permissions and their declaration form. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Every service Cupola manages lives on the user's own network. Android's
         Local Network Protections gate that traffic behind this runtime
         permission: opt-in on Android 16, mandatory from Android 17 for apps
         that target it. Declared now so the day `targetSdk` reaches 37 the
        connection tests ask for it instead of silently timing out; the gate in
         `MainActivity.localNetworkIsGated` keeps it inert until then, and on
         every older release the name is simply ignored. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK"/>
    <application
        android:label="Cupola"
        android:name="${applicationName}"
        android:icon="@mipmap/cupola_icon"
        android:roundIcon="@mipmap/cupola_icon_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:allowBackup="false">
        <!-- Portrait only, deliberately: the collapsing hero, the floating bar's
             clearance and the poster rails are vertical instruments, and Cupola
             has no landscape phone layout. See The Portrait Rule in DESIGN.md.

             `orientation` stays in `configChanges` even though a locked
             activity should never see one. From Android 16 the platform ignores
             `screenOrientation` on displays whose smallest width is 600dp or
            more (tablets, unfolded foldables, desktop windowing), so on
             exactly those devices the lock is advisory and the rotation still
             arrives. Dropping the flag there would trade a resize for an
             activity recreation. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- An invite to a Seerr opens the app: cupola://invite?…, from a
                 QR or a link. Flutter hands the whole link to the router, which
                 reads it (lib/features/discover/domain/seerr_invite.dart). -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="true"
              />
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="cupola" android:host="invite"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- The Jellyfin apps Cupola can hand an item to (`streamAppLauncher`):
             asked with canLaunchUrl before the viewer is offered them. Swiftfin
             is iOS only and needs no entry here. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="streamyfin"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="fladder"/>
        </intent>
    </queries>
</manifest>
