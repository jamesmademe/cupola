<?xml version="1.0" encoding="utf-8"?>
<!--
  Resources named only from Dart, which the release build's resource shrinker
  cannot see: flutter_local_notifications looks the notification small icon up
  by name at runtime (AndroidInitializationSettings in
  lib/features/release_search/data/release_search_notifications.dart). Without
  this the shrinker strips it and every notification fails to post.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_cupola" />
