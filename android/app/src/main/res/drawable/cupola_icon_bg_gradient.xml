<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background for the default/light appearance. The night
  resource intentionally uses the same palette for deterministic icon output.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#171D31"
        android:centerColor="#0C0F1A"
        android:endColor="#07080E"
        android:type="linear" />
</shape>
