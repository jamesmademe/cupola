<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen before Android 12: the Cupola mark at 112dp, centred on
     the room's ground. The mark is generated by scripts/icons/export.py. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_ground" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_mark" />
    </item>
</layer-list>
