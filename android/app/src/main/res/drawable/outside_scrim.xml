<?xml version="1.0" encoding="utf-8"?>
<!--
  The scrim behind words over artwork: a ramp from clear to full strength, then
  full strength for the rest. Laid over a view that starts above the words' own
  block by the ramp and the margin (`outside_scrim_reach`), so the block has a
  margin of full strength above its first line and the ramp is above that.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:height="@dimen/outside_scrim_ramp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/outside_scrim_foot"
                android:startColor="@color/outside_scrim_clear" />
        </shape>
    </item>
    <item android:top="@dimen/outside_scrim_ramp">
        <shape android:shape="rectangle">
            <solid android:color="@color/outside_scrim_foot" />
        </shape>
    </item>
</layer-list>
