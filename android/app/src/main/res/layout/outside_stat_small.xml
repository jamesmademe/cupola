<?xml version="1.0" encoding="utf-8"?>
<!--
  A small widget on its ground that leads with a figure or a line and under it one
  thing with its bar: Downloads, and Your requests when nothing is ready. The
  bar's tone is its fill; the item's last line is its words in their tone, or
  the age where the drawing is old enough to say so.

  The figure is two bitmap masks (`figure_mask`, `figure_words_mask`) in the
  app's own face, tinted from the resources (OutsideFigure); `figure` and
  `figure_words` are the same in the system face, for an Android that cannot
  draw them.

  Text slots come in one view per tone (`words_default`, `words_green`, and so on),
  each in that tone's own colour, and OutsideSlots shows the one the face names
  and hides the others. The colour is the view's and not the code's because a
  colour set from code is a colour of the moment it is set: the launcher inflates
  this layout again when the system changes room, and only a colour resolved from
  the resources follows it.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/outside_ground">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/outside_space_slab_y">
        <TextView
            style="@style/OutsideText.Label"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/outside_space_sm"
            android:textColor="@color/outside_dim"
            android:maxLines="1"
            android:ellipsize="end" />
        <LinearLayout
            tools:ignore="UselessLeaf,NestedWeights"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <LinearLayout
            android:id="@+id/figure_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:baselineAligned="false">
            <ImageView
                android:id="@+id/figure_mask"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tint="@color/outside_ink"
                android:importantForAccessibility="no"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/figure_words_mask"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/outside_space_sm"
                android:tint="@color/outside_dim"
                android:importantForAccessibility="no"
                android:visibility="gone" />
            <TextView
                style="@style/OutsideText.FigureHero"
                android:id="@+id/figure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/outside_ink"
                android:maxLines="1"
                android:visibility="gone"
                android:importantForAccessibility="no" />
            <TextView
                style="@style/OutsideText.FigureSmall"
                android:id="@+id/figure_words"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/outside_space_sm"
                android:textColor="@color/outside_dim"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <TextView
            style="@style/OutsideText.Line"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/outside_dim"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/outside_space_row"
            android:visibility="gone">
            <TextView
                style="@style/OutsideText.Title"
                android:id="@+id/item_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/outside_ink"
                android:maxLines="1"
                android:ellipsize="end" />
            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:id="@+id/bar_default"
                android:layout_width="match_parent"
                android:layout_height="@dimen/outside_bar_height"
                android:layout_marginTop="@dimen/outside_space_xs"
                android:max="1000"
                android:progressDrawable="@drawable/outside_bar_ink"
                android:indeterminate="false"
                android:visibility="gone"
                android:importantForAccessibility="no" />
            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:id="@+id/bar_green"
                android:layout_width="match_parent"
                android:layout_height="@dimen/outside_bar_height"
                android:layout_marginTop="@dimen/outside_space_xs"
                android:max="1000"
                android:progressDrawable="@drawable/outside_bar_green"
                android:indeterminate="false"
                android:visibility="gone"
                android:importantForAccessibility="no" />
            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:id="@+id/bar_amber"
                android:layout_width="match_parent"
                android:layout_height="@dimen/outside_bar_height"
                android:layout_marginTop="@dimen/outside_space_xs"
                android:max="1000"
                android:progressDrawable="@drawable/outside_bar_amber"
                android:indeterminate="false"
                android:visibility="gone"
                android:importantForAccessibility="no" />
            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:id="@+id/bar_blue"
                android:layout_width="match_parent"
                android:layout_height="@dimen/outside_bar_height"
                android:layout_marginTop="@dimen/outside_space_xs"
                android:max="1000"
                android:progressDrawable="@drawable/outside_bar_blue"
                android:indeterminate="false"
                android:visibility="gone"
                android:importantForAccessibility="no" />
            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:id="@+id/bar_neutral"
                android:layout_width="match_parent"
                android:layout_height="@dimen/outside_bar_height"
                android:layout_marginTop="@dimen/outside_space_xs"
                android:max="1000"
                android:progressDrawable="@drawable/outside_bar_neutral"
                android:indeterminate="false"
                android:visibility="gone"
                android:importantForAccessibility="no" />
            <TextView
                style="@style/OutsideText.Line"
                android:id="@+id/age"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/outside_space_xs"
                android:textColor="@color/outside_dim"
                android:maxLines="2"
                android:ellipsize="end"
                android:visibility="gone" />
            <TextView
                style="@style/OutsideText.Line"
                android:id="@+id/words_default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/outside_space_xs"
                android:textColor="@color/outside_ink"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
            <TextView
                style="@style/OutsideText.Line"
                android:id="@+id/words_green"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/outside_space_xs"
                android:textColor="@color/outside_green"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
            <TextView
                style="@style/OutsideText.Line"
                android:id="@+id/words_amber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/outside_space_xs"
                android:textColor="@color/outside_amber"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
            <TextView
                style="@style/OutsideText.Line"
                android:id="@+id/words_blue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/outside_space_xs"
                android:textColor="@color/outside_blue"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
            <TextView
                style="@style/OutsideText.Line"
                android:id="@+id/words_neutral"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/outside_space_xs"
                android:textColor="@color/outside_neutral"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>
        <TextView
            style="@style/OutsideText.Title"
            android:id="@+id/calm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/outside_ink"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />
        <TextView
            style="@style/OutsideText.Line"
            android:id="@+id/calm_age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/outside_space_xs"
            android:textColor="@color/outside_dim"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
