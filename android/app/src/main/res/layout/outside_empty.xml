<?xml version="1.0" encoding="utf-8"?>
<!--
  A widget with nothing to draw: its name and one line (`outside_no_file`, or
  `outside_kind_absent`). The same in every size.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/outside_ground">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/outside_space_slab_y">
        <TextView
            style="@style/OutsideText.Title"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/outside_space_xxs"
            android:textColor="@color/outside_ink"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            style="@style/OutsideText.Line"
            android:id="@+id/line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/outside_dim"
            android:maxLines="3"
            android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
