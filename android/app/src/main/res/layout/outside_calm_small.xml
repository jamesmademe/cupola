<?xml version="1.0" encoding="utf-8"?>
<!--
  A small widget with nothing to lead with: its name above, what it says of that
  below, and its age once the drawing is old enough to say so.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/outside_ground">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/outside_space_slab_y">
        <TextView
            style="@style/OutsideText.Label"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/outside_space_sm"
            android:textColor="@color/outside_dim"
            android:maxLines="1"
            android:ellipsize="end" />
        <LinearLayout
            tools:ignore="UselessLeaf,NestedWeights"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <TextView
            style="@style/OutsideText.Title"
            android:id="@+id/calm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/outside_ink"
            android:maxLines="3"
            android:ellipsize="end"
            android:visibility="gone" />
        <TextView
            style="@style/OutsideText.Line"
            android:id="@+id/age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/outside_space_sm"
            android:textColor="@color/outside_dim"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
