<?xml version="1.0" encoding="utf-8"?>
<!-- From Android 12 the launcher rounds a widget to the system's radius, and the
     widget's own corners are the same, so the ground meets the artwork's edge
     exactly where the launcher cuts it. -->
<resources>
    <dimen name="outside_widget_radius">@android:dimen/system_app_widget_background_radius</dimen>
</resources>
