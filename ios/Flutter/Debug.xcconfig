#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

// The production identity. The testlab build passes
// FLUTTER_XCODE_CUPOLA_BUNDLE_SUFFIX=.testlab and
// FLUTTER_XCODE_CUPOLA_APP_GROUP=group.com.matthwlabs.cupola.testlab, so its
// preferences, keychain namespace and App Group cannot be the house's.
CUPOLA_BUNDLE_SUFFIX =
CUPOLA_APP_GROUP = group.com.matthwlabs.cupola

// The Runner target reads this. The testlab build overrides it through
// FLUTTER_XCODE_CUPOLA_ENTITLEMENTS=Runner/RunnerTestlab.entitlements, so the
// entitlement choice reaches the Runner target alone and not the Swift
// packages.
CUPOLA_ENTITLEMENTS = Runner/Runner.entitlements
