#include "../../Flutter/Flutter-Release.xcconfig"
#include "Warnings.xcconfig"

// The production identity (AGENTS.md, App identities). The testlab and dev
// builds override it through FLUTTER_XCODE_CUPOLA_BUNDLE_SUFFIX.
CUPOLA_BUNDLE_SUFFIX =

// Flutter 3.38.7 invokes lipo with multiple architectures, which Xcode 27
// rejects during release packaging. This Mac is Apple Silicon, so keep the
// release/profile artifact arm64 until the Flutter toolchain is upgraded.
ARCHS = arm64
